  "title": "主动批量审核接口",
  "doc_url": "https://cloud.tencent.com/document/product/269/100243",
  "sync_time": "2026-10-24 01:28:54",
  "status": "synced",
  "source_mode": "api",
  "requested_mode": "auto",
  "overview": "开启云端审核后，在 App 后台可以主动调用 REST API 接口，批量送审图文等相关内容，音视频审核请查看         主动审核接口        。",
  "rate_limit": "200次/秒。",
  "request_url_sample": "https://xxxxxx/v4/im_msg_audit/batch_content_moderation?sdkappid=88888888&identifier=admin&usersig=xxx&random=99999999&contenttype=json",
  "url_params": [
    {
      "name": "xxxxxx",
      "description": "当前仅支持中国、新加坡和首尔，SDKAppID 所在国家/地区对应的专属域名：中国：console.tim.qq.com新加坡：adminapisgp.im.qcloud.com首尔： adminapikr.im.qcloud.com其他数据中心暂不支持"
    },
    {
      "name": "v4/im_msg_audit/batch_content_moderation",
      "description": "请求接口，当前仅支持中国站。"
    },
    {
      "name": "sdkappid",
      "description": "创建应用时即时通信 IM 控制台分配的 SDKAppID。"
    },
    {
      "name": "identifier",
      "description": "必须为 App 管理员账号，更多详情请参见 App 管理员。"
    },
    {
      "name": "usersig",
      "description": "App 管理员账号生成的签名，具体操作请参见 生成 UserSig。"
    },
    {
      "name": "random",
      "description": "请输入随机的32位无符号整数，取值范围0 - 4294967295。"
    },
    {
      "name": "contenttype",
      "description": "请求格式固定值为json。"
    }
  ],
  "request_body_fields": [
    {
      "name": "AuditName",
      "type": "String",
      "required": "必填",
      "description": "表明审核配置。通用审核配置取值：C2C / Group / UserInfo / GroupInfo / GroupMemberInfo / RelationChain 自定义审核配置取值：自定义审核配置 ID自定义审核配置需在控制台创建好自定义审核配置 ID，主动审核接口将自定义审核配置 ID 直接赋值AuditName，从而走到自定义审核配置 ID 对应的审核场景。"
    },
    {
      "name": "Contents",
      "type": "Array",
      "required": "必填",
      "description": "批量送审数组，最多支持10个内容批量送审。"
    },
    {
      "name": "ContentId",
      "type": "Integer",
      "required": "必填",
      "description": "内容 ID，数组里各个成员，不能重复的 ContentId。"
    },
    {
      "name": "ContentType",
      "type": "String",
      "required": "必填",
      "description": "送审类型，批量审核接口里，限制取值：Text/Image，音视频送审请参见 主动审核接口。"
    },
    {
      "name": "Content",
      "type": "String",
      "required": "必填",
      "description": "送审内容，最大限制8KB，当审核文件时，填对应 URL。其中图片审核最大不超过5MB。"
    },
    {
      "name": "ExtSender",
      "type": "String",
      "required": "选填",
      "description": "发送方标识：可以置空，或填 IM 对应的 UserID，也可以填业务自定义的发送方标识。填写后，云端审核控制台明细里可以过滤分析。"
    },
    {
      "name": "ExtReceiver",
      "type": "String",
      "required": "选填",
      "description": "接收方标识：可以置空，或填 IM 对应的 UserID/GroupID，也可以填业务自定义接收方标识。填写后，云端审核控制台明细里可以过滤分析。"
    }
  ],
  "request_examples": [
    {
      "title": "请求包示例",
      "content": "{\n\n    \"AuditName\":\"Group\",\n\n    \"Contents\":[\n\n        {\n\n            \"ContentId\":0,\n\n            \"ContentType\":\"Text\",\n\n            \"Content\":\"abc123\"\n\n        },\n\n        {\n\n            \"ContentId\":1,\n\n            \"ContentType\":\"Text\",\n\n            \"Content\":\"abc1234\"\n\n        },\n\n        {\n\n            \"ContentId\":2,\n\n            \"ContentType\":\"Image\",\n\n            \"Content\":\"https://www.simple.com/1.jpg\"\n\n        },\n\n        {\n\n            \"ContentId\":3,\n\n            \"ContentType\":\"Text\",\n\n            \"Content\":\"tttcccc\"\n\n        }\n\n    ],\n\n    \"ExtSender\":\"sender_xx\",\n\n    \"ExtReceiver\":\"receiver_yy\"\n\n}",
      "clean_json": "{\n\n    \"AuditName\":\"Group\",\n\n    \"Contents\":[\n\n        {\n\n            \"ContentId\":0,\n\n            \"ContentType\":\"Text\",\n\n            \"Content\":\"abc123\"\n\n        },\n\n        {\n\n            \"ContentId\":1,\n\n            \"ContentType\":\"Text\",\n\n            \"Content\":\"abc1234\"\n\n        },\n\n        {\n\n            \"ContentId\":2,\n\n            \"ContentType\":\"Image\",\n\n            \"Content\":\"https://www.simple.com/1.jpg\"\n\n        },\n\n        {\n\n            \"ContentId\":3,\n\n            \"ContentType\":\"Text\",\n\n            \"Content\":\"tttcccc\"\n\n        }\n\n    ],\n\n    \"ExtSender\":\"sender_xx\",\n\n    \"ExtReceiver\":\"receiver_yy\"\n\n}"
    }
  ],
  "response_body_fields": [
    {
      "name": "ActionStatus",
      "type": "String",
      "description": "请求处理的结果：OK：表示处理成功FAIL：表示失败"
    },
    {
      "name": "ErrorCode",
      "type": "Integer",
      "description": "错误码：0：表示成功非0：表示失败"
    },
    {
      "name": "ErrorInfo",
      "type": "String",
      "description": "详细的错误信息。"
    },
    {
      "name": "AuditResults",
      "type": "Array",
      "description": "批量审核结果数组。"
    },
    {
      "name": "ContentId",
      "type": "Integer",
      "description": "内容 ID，同步请求里面的 ContentId。"
    },
    {
      "name": "RequestId",
      "type": "String",
      "description": "审核唯一标识。"
    },
    {
      "name": "Result",
      "type": "String",
      "description": "图文审核建议，Pass/Review/Block。"
    },
    {
      "name": "Keywords",
      "type": "Array",
      "description": "违规时，命中的关键词，如果模型命中不会有关键词返回。"
    },
    {
      "name": "Score",
      "type": "Integer",
      "description": "图文审核恶意值，0-100，恶意程度与 Score 成正比。"
    },
    {
      "name": "Label",
      "type": "String",
      "description": "送审内容命中的标签 Normal/Polity/Porn/Illegal/Abuse/Terror/Ad/Sexy/Composite。"
    },
    {
      "name": "SubLabel",
      "type": "String",
      "description": "命中的二级标签。"
    }
  ],
