  "title": "添加好友",
  "doc_url": "https://cloud.tencent.com/document/product/269/1643",
  "sync_time": "2026-10-24 01:43:23",
  "status": "synced",
  "source_mode": "api",
  "requested_mode": "auto",
  "overview": "添加好友，支持批量添加好友。",
  "rate_limit": "200次/秒。",
  "request_url_sample": "https://xxxxxx/v4/sns/friend_add?sdkappid=88888888&identifier=admin&usersig=xxx&random=99999999&contenttype=json",
  "url_params": [
    {
      "name": "xxxxxx",
      "description": "SDKAppID 所在国家/地区对应的专属域名：中国：console.tim.qq.com新加坡：adminapisgp.im.qcloud.com首尔：adminapikr.im.qcloud.com东京：adminapijpn.im.qcloud.com法兰克福：adminapiger.im.qcloud.com硅谷：adminapiusa.im.qcloud.com雅加达：adminapiidn.im.qcloud.com利雅得：adminapiksa.im.qcloud.com"
    },
    {
      "name": "v4/sns/friend_add",
      "description": "请求接口。"
    },
    {
      "name": "sdkappid",
      "description": "创建应用时即时通信 IM 控制台分配的 SDKAppID。"
    },
    {
      "name": "identifier",
      "description": "必须为 App 管理员账号，更多详情请参见 App 管理员。"
    },
    {
      "name": "usersig",
      "description": "App 管理员账号生成的签名，具体操作请参见 生成 UserSig。"
    },
    {
      "name": "random",
      "description": "请输入随机的32位无符号整数，取值范围0 - 4294967295。"
    },
    {
      "name": "contenttype",
      "description": "请求格式固定值为 json。"
    }
  ],
  "request_body_fields": [
    {
      "name": "From_Account",
      "type": "String",
      "required": "必填",
      "description": "需要为该 UserID 添加好友。"
    },
    {
      "name": "AddFriendItem",
      "type": "Array",
      "required": "必填",
      "description": "好友结构体对象，单次请求的好友数不得超过1000。"
    },
    {
      "name": "To_Account",
      "type": "String",
      "required": "必填",
      "description": "好友的 UserID。"
    },
    {
      "name": "Remark",
      "type": "String",
      "required": "选填",
      "description": "From_Account 对 To_Account 的好友备注，详情可参见 标配好友字段。"
    },
    {
      "name": "GroupName",
      "type": "String",
      "required": "选填",
      "description": "From_Account 对 To_Account 的分组信息，添加好友时只允许设置一个分组，因此使用 String 类型即可，详情可参见 标配好友字段。"
    },
    {
      "name": "AddSource",
      "type": "String",
      "required": "必填",
      "description": "加好友来源字段，详情可参见 标配好友字段。"
    },
    {
      "name": "AddWording",
      "type": "String",
      "required": "选填",
      "description": "From_Account 和 To_Account 形成好友关系时的附言信息，详情可参见 标配好友字段。"
    },
    {
      "name": "AddType",
      "type": "String",
      "required": "选填",
      "description": "加好友方式（默认双向加好友方式）：Add_Type_Single 表示单向加好友。Add_Type_Both 表示双向加好友。"
    },
    {
      "name": "ForceAddFlags",
      "type": "Integer",
      "required": "选填",
      "description": "管理员强制加好友标记：1：表示强制加好友。0：表示常规加好友方式。"
    }
  ],
  "request_examples": [
    {
      "title": "基础形式",
      "content": "{\n\n  \"From_Account\":\"id\",\n\n  \"AddFriendItem\":\n\n  [\n\n      {\n\n          \"To_Account\":\"id1\",\n\n          \"AddSource\":\"AddSource_Type_XXXXXXXX\"\n\n      }\n\n  ]\n\n}",
      "clean_json": "{\n  \"From_Account\": \"id\",\n  \"AddFriendItem\": [\n    {\n      \"To_Account\": \"id1\",\n      \"AddSource\": \"AddSource_Type_XXXXXXXX\"\n    }\n  ]\n}"
    },
    {
      "title": "完整形式",
      "content": "{\n\n  \"From_Account\":\"id\",\n\n  \"AddFriendItem\":\n\n  [\n\n      {\n\n          \"To_Account\":\"id1\",\n\n          \"Remark\":\"remark1\",\n\n          \"GroupName\":\"同学\",\n\n          \"AddSource\":\"AddSource_Type_XXXXXXXX\",\n\n          \"AddWording\":\"I'm Test1\"\n\n      }\n\n  ],\n\n  \"AddType\":\"Add_Type_Both\",\n\n  \"ForceAddFlags\":1\n\n}",
      "clean_json": "{\n  \"From_Account\": \"id\",\n  \"AddFriendItem\": [\n    {\n      \"To_Account\": \"id1\",\n      \"Remark\": \"remark1\",\n      \"GroupName\": \"同学\",\n      \"AddSource\": \"AddSource_Type_XXXXXXXX\",\n      \"AddWording\": \"I'm Test1\"\n    }\n  ],\n  \"AddType\": \"Add_Type_Both\",\n  \"ForceAddFlags\": 1\n}"
    },
    {
      "title": "批量形式",
      "content": "{\n\n  \"From_Account\":\"id\",\n\n  \"AddFriendItem\":\n\n  [\n\n      {\n\n          \"To_Account\":\"id1\",\n\n          \"AddSource\":\"AddSource_Type_XXXXXXXX\"\n\n      },\n\n      {\n\n          \"To_Account\":\"id2\",\n\n          \"Remark\":\"remark2\",\n\n          \"GroupName\":\"同学\",\n\n          \"AddSource\":\"AddSource_Type_XXXXXXXX\",\n\n          \"AddWording\":\"I'm Test2\"\n\n      },\n\n      {\n\n          \"To_Account\":\"id3\",\n\n          \"Remark\":\"remark3\",\n\n          \"GroupName\":\"同事\",\n\n          \"AddSource\":\"AddSource_Type_XXXXXXXX\",\n\n          \"AddWording\":\"I'm Test3\"\n\n      }\n\n  ],\n\n  \"AddType\":\"Add_Type_Both\",\n\n  \"ForceAddFlags\":1\n\n}",
      "clean_json": "{\n  \"From_Account\": \"id\",\n  \"AddFriendItem\": [\n    {\n      \"To_Account\": \"id1\",\n      \"AddSource\": \"AddSource_Type_XXXXXXXX\"\n    },\n    {\n      \"To_Account\": \"id2\",\n      \"Remark\": \"remark2\",\n      \"GroupName\": \"同学\",\n      \"AddSource\": \"AddSource_Type_XXXXXXXX\",\n      \"AddWording\": \"I'm Test2\"\n    },\n    {\n      \"To_Account\": \"id3\",\n      \"Remark\": \"remark3\",\n      \"GroupName\": \"同事\",\n      \"AddSource\": \"AddSource_Type_XXXXXXXX\",\n      \"AddWording\": \"I'm Test3\"\n    }\n  ],\n  \"AddType\": \"Add_Type_Both\",\n  \"ForceAddFlags\": 1\n}"
    }
  ],
  "response_body_fields": [
    {
      "name": "ResultItem",
      "type": "Array",
      "description": "批量加好友的结果对象数组。"
    },
    {
      "name": "To_Account",
      "type": "String",
      "description": "请求添加的好友的 UserID。"
    },
    {
      "name": "ResultCode",
      "type": "Integer",
      "description": "To_Account 的处理结果，0表示成功，非0表示失败，非0取值的详细描述请参见 错误码说明。"
    },
    {
      "name": "ResultInfo",
      "type": "String",
      "description": "To_Account 的错误描述信息，成功时该字段为空。"
    },
    {
      "name": "Fail_Account",
      "type": "Array",
      "description": "返回处理失败的用户列表，仅当存在失败用户时才返回该字段。"
    },
    {
      "name": "ActionStatus",
      "type": "String",
      "description": "请求处理的结果OK：表示处理成功。FAIL：表示失败。"
    },
    {
      "name": "ErrorCode",
      "type": "Integer",
      "description": "错误码：0：表示成功。非0：表示失败，非0取值的详细描述请参见 错误码说明。"
    },
    {
      "name": "ErrorInfo",
      "type": "String",
      "description": "详细错误信息。"
    },
    {
      "name": "ErrorDisplay",
      "type": "String",
      "description": "详细的客户端展示信息。"
    }
  ],
