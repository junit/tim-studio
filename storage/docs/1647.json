{
  "doc_id": 1647,
  "api_id": "sns_friend_get",
  "title": "拉取好友",
  "doc_url": "https://cloud.tencent.com/document/product/269/1647",
  "sync_time": "2026-10-23 23:20:59",
  "status": "synced",
  "overview": "分页拉取全量好友数据。\n不支持资料数据的拉取。\n默认每页返回500个好友。\n不需要指定请求拉取的字段，默认返回全量的标配好友数据和自定义好友数据。",
  "rate_limit": "200次/秒。",
  "request_url_sample": "https://xxxxxx/v4/sns/friend_get?sdkappid=88888888&identifier=admin&usersig=xxx&random=99999999&contenttype=json",
  "url_params": [
    {
      "name": "xxxxxx",
      "description": "SDKAppID 所在国家/地区对应的专属域名：中国：console.tim.qq.com新加坡：adminapisgp.im.qcloud.com首尔： adminapikr.im.qcloud.com东京：adminapijpn.im.qcloud.com法兰克福：adminapiger.im.qcloud.com硅谷：adminapiusa.im.qcloud.com雅加达：adminapiidn.im.qcloud.com利雅得：adminapiksa.im.qcloud.com"
    },
    {
      "name": "v4/sns/friend_get",
      "description": "请求接口。"
    },
    {
      "name": "sdkappid",
      "description": "创建应用时即时通信 IM 控制台分配的 SDKAppID。"
    },
    {
      "name": "identifier",
      "description": "必须为 App 管理员账号，更多详情请参见 App 管理员。"
    },
    {
      "name": "usersig",
      "description": "App 管理员账号生成的签名，具体操作请参见 生成 UserSig。"
    },
    {
      "name": "random",
      "description": "请输入随机的32位无符号整数，取值范围0 - 4294967295。"
    },
    {
      "name": "contenttype",
      "description": "请求格式固定值为 json。"
    }
  ],
  "request_body_fields": [
    {
      "name": "From_Account",
      "type": "String",
      "required": "必填",
      "description": "指定要拉取好友数据的用户的 UserID。"
    },
    {
      "name": "StartIndex",
      "type": "Integer",
      "required": "必填",
      "description": "分页的起始位置。"
    },
    {
      "name": "StandardSequence",
      "type": "Integer",
      "required": "选填",
      "description": "上次拉好友数据时返回的 StandardSequence，如果 StandardSequence 字段的值与后台一致，后台不会返回标配好友数据。"
    }
  ],
  "request_examples": [
    {
      "title": "请求包示例",
      "content": "{\n\n    \"From_Account\": \"id\",\n\n    \"StartIndex\": 0,\n\n    \"StandardSequence\": 0\n\n}",
      "clean_json": "{\n  \"From_Account\": \"id\",\n  \"StartIndex\": 0,\n  \"StandardSequence\": 0\n}"
    }
  ],
  "response_body_fields": [
    {
      "name": "UserDataItem",
      "type": "Array",
      "description": "好友对象数组，每一个好友对象都包含一个 To_Account 字段和一个 ValueItem 数组。"
    },
    {
      "name": "To_Account",
      "type": "String",
      "description": "好友的 UserID。"
    },
    {
      "name": "ValueItem",
      "type": "Array",
      "description": "保存好友数据的数组，数组每一个元素都包含一个 Tag 字段和一个 Value 字段。"
    },
    {
      "name": "Tag",
      "type": "String",
      "description": "好友字段的名称。"
    },
    {
      "name": "Value",
      "type": "String/Integer/Array",
      "description": "好友字段的值，详情可参见 关系链字段。"
    },
    {
      "name": "StandardSequence",
      "type": "Integer",
      "description": "标配好友数据的 Sequence，客户端可以保存该 Sequence，下次请求时通过请求的 StandardSequence 字段返回给后台。"
    },
    {
      "name": "FriendNum",
      "type": "Integer",
      "description": "好友总数。"
    },
    {
      "name": "CompleteFlag",
      "type": "Integer",
      "description": "分页的结束标识，非0值表示已完成全量拉取。"
    },
    {
      "name": "NextStartIndex",
      "type": "Integer",
      "description": "分页接口下一页的起始位置。"
    },
    {
      "name": "ActionStatus",
      "type": "String",
      "description": "请求处理的结果：OK：表示处理成功。FAIL：表示失败。"
    },
    {
      "name": "ErrorCode",
      "type": "Integer",
      "description": "错误码：0：表示成功。非0：表示失败，非0取值的详细描述请参见 错误码说明。"
    },
    {
      "name": "ErrorInfo",
      "type": "String",
      "description": "详细错误信息。"
    },
    {
      "name": "ErrorDisplay",
      "type": "String",
      "description": "详细的客户端展示信息。"
    }
  ],
  "response_examples": [
    {
      "title": "成功应答示例",
