      "content": "{\n\n    \"GroupId\": \"@TGS#_@TGS#cV6IHIIM62C4\",\n\n    \"PermissionGroupId\": \"@PMG#_test_permission_group_with_topic\",\n\n    \"TopicIdList\": [\n\n        \"@TGS#_@TGS#cV6IHIIM62C4@TOPIC#_@TOPIC#cTEJHIIM62CJ\"\n\n    ]\n\n}",
