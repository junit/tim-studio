  "overview": "支持批量更新同一用户的多个好友的关系链数据。\n更新用户的多个好友时，建议使用批量方式，以避免并发写操作导致的写冲突。",
  "rate_limit": "200次/秒。",
  "request_url_sample": "https://xxxxxx/v4/sns/friend_update?sdkappid=88888888&identifier=admin&usersig=xxx&random=99999999&contenttype=json",
  "url_params": [
    {
      "name": "xxxxxx",
      "description": "SDKAppID 所在国家/地区对应的专属域名：中国：console.tim.qq.com新加坡：adminapisgp.im.qcloud.com首尔： adminapikr.im.qcloud.com东京：adminapijpn.im.qcloud.com法兰克福：adminapiger.im.qcloud.com硅谷：adminapiusa.im.qcloud.com雅加达：adminapiidn.im.qcloud.com利雅得：adminapiksa.im.qcloud.com"
    },
    {
      "name": "v4/sns/friend_update",
      "description": "请求接口。"
    },
    {
      "name": "sdkappid",
      "description": "创建应用时即时通信 IM 控制台分配的 SDKAppID。"
    },
    {
      "name": "identifier",
      "description": "必须为 App 管理员账号，更多详情请参见 App 管理员。"
    },
    {
      "name": "usersig",
      "description": "App 管理员账号生成的签名，具体操作请参见 生成 UserSig。"
    },
    {
      "name": "random",
      "description": "请输入随机的32位无符号整数，取值范围0 - 4294967295。"
    },
    {
      "name": "contenttype",
      "description": "请求格式固定值为 json。"
    }
  ],
  "request_body_fields": [
    {
      "name": "From_Account",
      "type": "String",
      "required": "必填",
      "description": "需要更新该 UserID 的关系链数据。"
    },
    {
      "name": "UpdateItem",
      "type": "Array",
      "required": "必填",
      "description": "需要更新的好友对象数组，单次请求的好友数不得超过1000。"
    },
    {
      "name": "To_Account",
      "type": "String",
      "required": "必填",
      "description": "好友的 UserID。"
    },
    {
      "name": "SnsItem",
      "type": "Array",
      "required": "必填",
      "description": "需要更新的关系链数据对象数组。"
    },
    {
      "name": "Tag",
      "type": "String",
      "required": "必填",
      "description": "需要更新的关系链字段的字段名，目前只支持好友备注、好友分组、关系链自定义字段的更新操作，关系链字段的详细信息可参见 好友表。"
    },
    {
      "name": "Value",
      "type": "Array/String/Integer",
      "required": "必填",
      "description": "需要更新的关系链字段的值，关系链字段的值类型信息可参见 好友表。"
    }
  ],
