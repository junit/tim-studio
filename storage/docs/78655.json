  "overview": "接口请求域名： live.tencentcloudapi.com 。\n批量绑定证书对应的播放域名，并更新启用状态。\n新建自有证书将自动上传至腾讯云ssl。\n默认接口请求频率限制：20次/秒。\n推荐使用 API Explorer\n点击调试\nAPI Explorer 提供了在线调用、签名验证、SDK 代码生成和快速检索接口等能力。您可查看每次调用的请求内容和返回结果以及自动生成 SDK 调用示例。",
  "rate_limit": "",
  "request_url_sample": "",
  "url_params": [],
  "request_body_fields": [
    {
      "name": "Action",
      "type": "String",
      "required": "公共参数",
      "description": "公共参数，本接口取值：ModifyLiveDomainCertBindings。"
    },
    {
      "name": "Version",
      "type": "String",
      "required": "公共参数",
      "description": "公共参数，本接口取值：2018-08-01。"
    },
    {
      "name": "Region",
      "type": "String",
      "required": "公共参数",
      "description": "公共参数，本接口不需要传递此参数。"
    },
    {
      "name": "DomainInfos.N",
      "type": "Array of LiveCertDomainInfo",
      "required": "必填",
      "description": "要绑定证书的播放域名/状态 信息列表。如果CloudCertId和证书公钥私钥对均不传，且域名列表已有绑定规则，只批量更新域名https规则的启用状态，并把未上传至腾讯云ssl的已有自有证书上传。"
    },
    {
      "name": "CloudCertId",
      "type": "String",
      "required": "选填",
      "description": "腾讯云ssl的证书Id。见 https://cloud.tencent.com/document/api/400/41665示例值：Kf2ymCv"
    },
    {
      "name": "CertificatePublicKey",
      "type": "String",
      "required": "选填",
      "description": "证书公钥。CloudCertId和公钥私钥对二选一，若CloudCertId将会舍弃公钥和私钥参数，否则将自动先把公钥私钥对上传至ssl新建证书，并使用上传成功后返回的CloudCertId。示例值：NXpT4oZAQ0JLclP1I9EbV8daGk9j86hd1oWJlmGMuz-Qc"
    },
    {
      "name": "CertificatePrivateKey",
      "type": "String",
      "required": "选填",
      "description": "证书私钥。CloudCertId和公钥私钥对二选一，若传CloudCertId将会舍弃公钥和私钥参数，否则将自动先把公钥私钥对上传至ssl新建证书，并使用上传成功后返回的CloudCertId。示例值：lb7KhNmJL8wS7XXIZeFreu353WIeYtQX8xz4OOLwWR2pwamXsH5rLGVSVSDMnpjhd6q7RMbxJeNyByL3WpytvXgA1bn4w"
    },
    {
      "name": "CertificateAlias",
      "type": "String",
      "required": "选填",
      "description": "上传至ssl证书中心的备注信息，只有新建证书时有效。传CloudCertId时会忽略。示例值：Kf2ymCv"
    }
  ],
  "request_examples": [
    {
      "title": "输入示例",
      "content": "POST / HTTP/1.1\nHost: live.tencentcloudapi.com\nContent-Type: application/json\nX-TC-Action: ModifyLiveDomainCertBindings\n<公共请求参数>\n\n{\n    \"CloudCertId\": \"hZy2N9vF\",\n    \"DomainInfos\": [\n        {\n            \"DomainName\": \"abc.tst.com.cn\",\n            \"Status\": 1\n        }\n    ]\n}",
      "clean_json": "{\n  \"CloudCertId\": \"hZy2N9vF\",\n  \"DomainInfos\": [\n    {\n      \"DomainName\": \"abc.tst.com.cn\",\n      \"Status\": 1\n    }\n  ]\n}"
    }
  ],
