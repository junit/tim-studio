    },
    {
      "name": "v4/follow/follow_get",
      "description": "请求接口。"
    },
    {
      "name": "sdkappid",
      "description": "创建应用时即时通信 IM 控制台分配的 SDKAppID。"
    },
    {
      "name": "identifier",
      "description": "必须为 App 管理员账号，更多详情请参见 App 管理员。"
    },
    {
      "name": "usersig",
      "description": "App 管理员账号生成的签名，具体操作请参见 生成 UserSig。"
    },
    {
      "name": "random",
      "description": "请输入随机的32位无符号整数，取值范围0 - 4294967295。"
    },
    {
      "name": "contenttype",
      "description": "请求格式固定值为 json。"
    }
  ],
  "request_body_fields": [
    {
      "name": "From_Account",
      "type": "String",
      "required": "必填",
      "description": "用户的 UserID。"
    },
    {
      "name": "FollowType",
      "type": "Integer",
      "required": "必填",
      "description": "待拉取的类型：1 - 粉丝2 - 关注3 - 互关"
    },
    {
      "name": "StartCursor",
      "type": "String",
      "required": "必填",
      "description": "分页的起始位置：首页为空，续拉请求填上一页回包返回的 NextCursor 字段。"
    },
    {
      "name": "WantNum",
      "type": "Integer",
      "required": "必填",
      "description": "拉取的数量：默认每页返回100条数据，最多支持1000条数据。"
    }
  ],
  "request_examples": [
    {
      "title": "请求包示例",
      "content": "{\n\n  \"From_Account\": \"UserID_001\",\n\n  \"FollowType\": 1,\n\n  \"StartCursor\": \"\",\n\n  \"WantNum\": 100\n\n}",
      "clean_json": "{\n  \"From_Account\": \"UserID_001\",\n  \"FollowType\": 1,\n  \"StartCursor\": \"\",\n  \"WantNum\": 100\n}"
