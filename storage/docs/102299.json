  "overview": "App 管理员可以通过该接口拉取公众号的历史消息。",
  "rate_limit": "200次/秒。",
  "request_url_sample": "https://xxxxxx/v4/official_account_open_http_svc/official_account_msg_get_simple?sdkappid=88888888&identifier=admin&usersig=xxx&random=99999999&contenttype=json",
  "url_params": [
    {
      "name": "xxxxxx",
      "description": "SDKAppID 所在国家/地区对应的专属域名：中国：console.tim.qq.com新加坡：adminapisgp.im.qcloud.com首尔： adminapikr.im.qcloud.com东京：adminapijpn.im.qcloud.com法兰克福：adminapiger.im.qcloud.com硅谷：adminapiusa.im.qcloud.com雅加达：adminapiidn.im.qcloud.com利雅得：adminapiksa.im.qcloud.com"
    },
    {
      "name": "v4/official_account_open_http_svc/official_account_msg_get_simple",
      "description": "请求接口。"
    },
    {
      "name": "sdkappid",
      "description": "创建应用时即时通信 IM 控制台分配的 SDKAppID。"
    },
    {
      "name": "identifier",
      "description": "必须为 App 管理员账号，更多详情请参见 App 管理员。"
    },
    {
      "name": "usersig",
      "description": "App 管理员账号生成的签名，具体操作请参见 生成 UserSig。"
    },
    {
      "name": "random",
      "description": "请输入随机的32位无符号整数，取值范围0 - 4294967295。"
    },
    {
      "name": "contenttype",
      "description": "请求格式固定值为 json。"
    }
  ],
  "request_body_fields": [
    {
      "name": "Official_Account",
      "type": "String",
      "required": "必填",
      "description": "要拉取历史消息的公众号用户。"
    },
    {
      "name": "LastMsgKey",
      "type": "String",
      "required": "选填",
      "description": "上一次拉取到的最后一条消息的 MsgKey，续拉时需要填该字段，填写方法见上方 示例。"
    },
    {
      "name": "ReqMsgNumber",
      "type": "Integer",
      "required": "选填",
      "description": "请求的消息条数。"
    },
    {
      "name": "WithRecalledMsg",
      "type": "Integer",
      "required": "选填",
      "description": "是否带撤回的消息，填1表明需要拉取撤回后的消息；默认不拉取撤回后的消息。"
    }
  ],
  "request_examples": [
    {
      "title": "基础形式",
      "content": "{\n\n  \"Official_Account\": \"@TOA#_15ERQPAER\",    //拉取消息的公众号用户\n\n  \"ReqMsgNumber\": 2      //需要拉取的消息条数\n\n}",
      "clean_json": "{\n  \"Official_Account\": \"@TOA#_15ERQPAER\",\n  \"ReqMsgNumber\": 2\n}"
    },
    {
      "title": "续拉",
      "content": "{\n\n  \"Official_Account\": \"@TOA#_15ERQPAER\",\n\n  \"LastMsgKey\": \"71_1_1698741698\",       // 续拉 MsgKey\n\n  \"ReqMsgNumber\": 2\n\n}",
      "clean_json": "{\n  \"Official_Account\": \"@TOA#_15ERQPAER\",\n  \"LastMsgKey\": \"71_1_1698741698\",\n  \"ReqMsgNumber\": 2\n}"
    }
  ],
  "response_body_fields": [
    {
      "name": "ActionStatus",
      "type": "String",
      "description": "请求处理的结果：OK：表示处理成功。FAIL：表示失败。"
    },
    {
      "name": "ErrorInfo",
      "type": "String",
      "description": "错误信息。"
    },
    {
      "name": "ErrorCode",
      "type": "Integer",
      "description": "错误码：0：表示成功。非0：表示失败。"
    },
    {
      "name": "Official_Account",
      "type": "String",
      "description": "请求中的公众号用户。"
    },
    {
      "name": "IsFinished",
      "type": "Integer",
      "description": "是否返回了请求区间的全部消息。当成功返回了请求区间的全部消息时，值为1。当消息长度太长或者区间太大（超过20）导致无法返回全部消息时，值为0。当请求区间之前的所有消息都过期时，值为2。"
    },
    {
      "name": "RspMsgList",
      "type": "Array",
      "description": "返回的消息列表。"
    },
    {
      "name": "IsPlaceMsg",
      "type": "Integer",
      "description": "是否是空洞消息，当消息被删除或者消息过期后：MsgBody 为空，该字段为1。撤回的消息，该字段为2。"
    },
    {
      "name": "MsgKey",
      "type": "String",
      "description": "标识该条消息，可用于 撤回公众号消息。"
    },
    {
      "name": "MsgSeq",
      "type": "Integer",
      "description": "消息 Seq，用于标识唯一消息，值越小发送的越早。"
    },
    {
      "name": "MsgTimeStamp",
      "type": "Integer",
      "description": "消息被发送的时间戳（单位：秒），server 的时间。"
    },
    {
      "name": "MsgBody",
      "type": "Object / Array",
      "description": "消息内容，详情请参见 消息内容 MsgBody 说明。"
    }
  ],
